# ThirdBooks Admin Panel Configuration

# Application
APP_NAME="ThirdBooks Admin"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# API Backend
API_BASE_URL=http://localhost:8000/api
API_TIMEOUT=30

# Admin Credentials (for initial setup)
ADMIN_EMAIL=admin@thirdbooks.com
ADMIN_PASSWORD=admin123

# Database (for admin panel sessions/cache)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thirdbooks_admin
DB_USERNAME=root
DB_PASSWORD=

# Session
SESSION_LIFETIME=120
SESSION_SECURE=false
