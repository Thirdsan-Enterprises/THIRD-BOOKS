APP_NAME=ThirdBooks
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Kampala
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Multi-Tenancy
TENANCY_ENABLED=true
TENANCY_MODE=single
CENTRAL_DOMAINS=localhost,thirdbooks.test,thirdbooks.digital

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# ThirdBooks supports both MySQL/MariaDB and PostgreSQL.
# MySQL is the default (DirectAdmin compatible).
#
# For MySQL/MariaDB (default):
#   DB_CONNECTION=mysql
#   DB_PORT=3306
#
# For PostgreSQL:
#   DB_CONNECTION=pgsql
#   DB_PORT=5432
# =============================================================================

# Database - Central (main database for tenants, users, etc.)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thirdbooks_central
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Database - Tenant (for multi-database tenancy mode)
# If using single tenancy mode, these can be the same as central DB
TENANT_DB_CONNECTION=tenant_mysql
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=root
TENANT_DB_PASSWORD=

# =============================================================================
# CACHE, SESSION & QUEUE
# =============================================================================
# For shared hosting without Redis, use 'file' or 'database' drivers.
# For VPS/dedicated servers with Redis, use 'redis' for better performance.
# =============================================================================

# Cache (use 'file' for shared hosting, 'redis' for VPS)
CACHE_STORE=file
CACHE_PREFIX=thirdbooks

# Session (use 'file' for shared hosting, 'redis' for VPS)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Queue (use 'database' for shared hosting, 'redis' for VPS)
QUEUE_CONNECTION=database

# Redis (optional - for VPS/dedicated servers)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@thirdbooks.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Filesystem
FILESYSTEM_DISK=local

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Broadcast
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log

# Currency API (for exchange rates)
CURRENCY_API_KEY=
CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest

# Security
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SESSION_DOMAIN=localhost

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Backup
BACKUP_ENABLED=true
BACKUP_DISK=s3
BACKUP_NOTIFICATIONS_EMAIL=admin@thirdbooks.com

# EFRIS Integration (Uganda Revenue Authority)
EFRIS_ENABLED=false
EFRIS_API_URL=
EFRIS_API_KEY=
EFRIS_TIN=

# Development
TELESCOPE_ENABLED=true
