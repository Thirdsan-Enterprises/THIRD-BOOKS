APP_NAME=ThirdBooks
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Kampala
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Multi-Tenancy
TENANCY_ENABLED=true
CENTRAL_DOMAINS=localhost,thirdbooks.test,thirdbooks.com

# Database - Central
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=thirdbooks_central
DB_USERNAME=postgres
DB_PASSWORD=

# Database - Tenant (used for multi-database tenancy)
TENANT_DB_CONNECTION=tenant_pgsql
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5432
TENANT_DB_USERNAME=postgres
TENANT_DB_PASSWORD=

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache
CACHE_STORE=redis
CACHE_PREFIX=thirdbooks

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Queue
QUEUE_CONNECTION=redis
QUEUE_PREFIX=thirdbooks

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@thirdbooks.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Filesystem
FILESYSTEM_DISK=local

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Broadcast
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log

# Currency API (for exchange rates)
CURRENCY_API_KEY=
CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest

# Security
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SESSION_DOMAIN=localhost

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Backup
BACKUP_ENABLED=true
BACKUP_DISK=s3
BACKUP_NOTIFICATIONS_EMAIL=admin@thirdbooks.com

# EFRIS Integration (Uganda Revenue Authority)
EFRIS_ENABLED=false
EFRIS_API_URL=
EFRIS_API_KEY=
EFRIS_TIN=

# Development
TELESCOPE_ENABLED=true
