# =====================================================
# THIRDBOOKS API - PRODUCTION CONFIGURATION
# Deploy to: api.thirdbooks.digital
# =====================================================

APP_NAME=ThirdBooks
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_AFTER_UPLOAD
APP_DEBUG=false
APP_TIMEZONE=Africa/Kampala
APP_URL=https://api.thirdbooks.digital
APP_LOCALE=en

# =====================================================
# DATABASE CONFIGURATION
# Update with your DirectAdmin MySQL credentials
# =====================================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# For single-tenant mode (recommended for shared hosting)
TENANCY_ENABLED=true
TENANCY_MODE=single

# Central domains - add your domains
CENTRAL_DOMAINS=api.thirdbooks.digital,thirdbooks.digital

# =====================================================
# CACHE & SESSION
# Using file driver for shared hosting compatibility
# =====================================================
CACHE_STORE=file
CACHE_PREFIX=thirdbooks

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# =====================================================
# QUEUE (Database driver for shared hosting)
# =====================================================
QUEUE_CONNECTION=database

# =====================================================
# MAIL CONFIGURATION
# Update with your SMTP credentials
# =====================================================
MAIL_MAILER=smtp
MAIL_HOST=mail.thirdbooks.digital
MAIL_PORT=587
MAIL_USERNAME=noreply@thirdbooks.digital
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@thirdbooks.digital"
MAIL_FROM_NAME="ThirdBooks"

# =====================================================
# FILESYSTEM
# =====================================================
FILESYSTEM_DISK=local

# =====================================================
# LOGGING
# =====================================================
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# =====================================================
# SECURITY - CORS & SANCTUM
# =====================================================
SANCTUM_STATEFUL_DOMAINS=thirdbooks.digital,api.thirdbooks.digital
SESSION_DOMAIN=.thirdbooks.digital

# Frontend URL (for CORS)
FRONTEND_URL=https://thirdbooks.digital

# =====================================================
# RATE LIMITING
# =====================================================
RATE_LIMIT_PER_MINUTE=60

# =====================================================
# BROADCAST (Disabled for now)
# =====================================================
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log
